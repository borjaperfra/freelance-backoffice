{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python backoffice.py:*)",
      "Bash(python -I adjuntos.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git pull:*)",
      "Read(datos/**)",
      "Read(bandeja/**)",
      "Read(docs/**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(rm -rf:*)",
      "Edit(datos/facturas/20*/**)",
      "Write(datos/facturas/20*/**)",
      "Edit(datos/espacios/accesos.json)",
      "Write(datos/espacios/accesos.json)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *+*)",
      "Bash(git -C * push*)",
      "Bash(git reset --hard*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -r datos*)",
      "Bash(rm -rf datos*)"
    ]
  }
}
